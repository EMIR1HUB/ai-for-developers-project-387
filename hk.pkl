amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping {
    ["actionlint"] = Builtins.actionlint
    ["ox_lint"] = (Builtins.ox_lint) {
        check = "oxlint --deny-warnings {{files}}"
    }
    ["oxfmt"] = (Builtins.oxfmt) {
        // Сгенерированные и сторонние файлы не форматируем: workflow Хекслета,
        // OpenAPI из TypeSpec, скиллы из mattpocock/skills (обновляются `npx skills update`),
        // CHANGELOG.md пишет release-please в своём формате
        exclude = List(
            ".github/workflows/hexlet-check.yml",
            "api/openapi.yaml",
            ".claude/skills/**",
            "skills-lock.json",
            "CHANGELOG.md"
        )
    }
}

steps = linters

hooks {
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "commitlint --edit {{commit_msg_file}}"
            }
        }
    }
}
