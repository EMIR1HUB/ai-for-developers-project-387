{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "react", "vitest"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["frontend/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Фронтенд вызывает API только через сгенерированный SDK (src/api/generated)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "fetch",
            "message": "Фронтенд вызывает API только через сгенерированный SDK (src/api/generated)."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Фронтенд вызывает API только через сгенерированный SDK (src/api/generated)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Фронтенд вызывает API только через сгенерированный SDK (src/api/generated)."
          }
        ]
      }
    },
    {
      "files": ["frontend/src/api/generated/**"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    }
  ]
}
